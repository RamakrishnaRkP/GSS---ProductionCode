  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function CalcV1(ByRef V1 As Decimal,ByRef TotalV1 As Decimal,Amt1 as Decimal,Amt2 as Decimal,Amt3 as Decimal,Amt4 as Decimal,Amt5 as Decimal,Q1 as Decimal,Q2 as Decimal,Q3 as Decimal,Q4 as Decimal,Q5 as Decimal)
    if Q1+Q2+Q3+Q4+Q5 &lt;&gt; 0 then
        V1  = Q1 * (Amt1+Amt2+Amt3+Amt4+Amt5)/(Q1+Q2+Q3+Q4+Q5)
        TotalV1 = TotalV1 + V1
        Return V1
    end if
    Return 0
End Function

Public Function CalcV2(ByRef V2 As Decimal,ByRef TotalV2 As Decimal,Amt1 as Decimal,Amt2 as Decimal,Amt3 as Decimal,Amt4 as Decimal,Amt5 as Decimal,Q1 as Decimal,Q2 as Decimal,Q3 as Decimal,Q4 as Decimal,Q5 as Decimal)
    if Q1+Q2+Q3+Q4+Q5 &lt;&gt; 0 then
        V2  = Q2 * (Amt1+Amt2+Amt3+Amt4+Amt5)/(Q1+Q2+Q3+Q4+Q5)
        TotalV2 = TotalV2 + V2
        Return V2
    end if
    Return 0
End Function

Public Function CalcV3(ByRef V3 As Decimal,ByRef TotalV3 As Decimal,Amt1 as Decimal,Amt2 as Decimal,Amt3 as Decimal,Amt4 as Decimal,Amt5 as Decimal,Q1 as Decimal,Q2 as Decimal,Q3 as Decimal,Q4 as Decimal,Q5 as Decimal)
    if Q1+Q2+Q3+Q4+Q5 &lt;&gt; 0 then
        V3  = Q3 * (Amt1+Amt2+Amt3+Amt4+Amt5)/(Q1+Q2+Q3+Q4+Q5)
        TotalV3 = TotalV3 + V3
        Return V3
    end if
    Return 0
End Function

Public Function CalcV4(ByRef V4 As Decimal,ByRef TotalV4 As Decimal,Amt1 as Decimal,Amt2 as Decimal,Amt3 as Decimal,Amt4 as Decimal,Amt5 as Decimal,Q1 as Decimal,Q2 as Decimal,Q3 as Decimal,Q4 as Decimal,Q5 as Decimal)
    if Q1+Q2+Q3+Q4+Q5 &lt;&gt; 0 then
        V4  = Q4 * (Amt1+Amt2+Amt3+Amt4+Amt5)/(Q1+Q2+Q3+Q4+Q5)
        TotalV4 = TotalV4 + V4
        Return V4
    end if
    Return 0
End Function

Public Function CalcV5(ByRef V5 As Decimal,ByRef TotalV5 As Decimal,Amt1 as Decimal,Amt2 as Decimal,Amt3 as Decimal,Amt4 as Decimal,Amt5 as Decimal,Q1 as Decimal,Q2 as Decimal,Q3 as Decimal,Q4 as Decimal,Q5 as Decimal)
    if Q1+Q2+Q3+Q4+Q5 &lt;&gt; 0 then
        V5  = Q5 * (Amt1+Amt2+Amt3+Amt4+Amt5)/(Q1+Q2+Q3+Q4+Q5)
        TotalV5 = TotalV5 + V5
        Return V5
    end if
    Return 0
End Function

Public Function Clear(ByRef Total As Decimal)
    Total = 0
    Return 0
End Function</Code>
